# KB Creator: default-deny. Only explicitly allowed, portable project state is
# tracked. Search tracked content with `git grep`: ripgrep honours this file and
# sees almost nothing.
*

# Repository metadata, agent guidance and Python project files.
!.gitignore
!.gitattributes
!README.md
!CLAUDE.md
!AGENTS.md
!pyproject.toml
!uv.lock

# KB Creator package and project state.
!kb_creator/
!kb_creator/README.md
!kb_creator/PROJECT_STATUS.md
!kb_creator/__init__.py
!kb_creator/__main__.py
!kb_creator/pipeline/
!kb_creator/pipeline/**
!kb_creator/scripts/
!kb_creator/scripts/**
!kb_creator/contracts/
!kb_creator/contracts/**
!kb_creator/reference/
!kb_creator/reference/**
!kb_creator/tests/
!kb_creator/tests/**
!kb_creator/docs/
!kb_creator/docs/**
!kb_creator/inputs/
!kb_creator/inputs/**
!kb_creator/reports/
!kb_creator/reports/**
!kb_creator/deliverables/
!kb_creator/deliverables/**

# Historical Innsmouth evidence kept from the NRI import. Exact files only, so
# new generated output cannot be added here by accident.
!kb_creator/output/
!kb_creator/output/innsmouth_final/
!kb_creator/output/innsmouth_final/runs/
!kb_creator/output/innsmouth_final/runs/20260730T172713Z/
!kb_creator/output/innsmouth_final/runs/20260730T172713Z/The_Innsmouth_Terror_Full_RU.html
!kb_creator/output/innsmouth_source_to_artifacts/
!kb_creator/output/innsmouth_source_to_artifacts/runs/
!kb_creator/output/innsmouth_source_to_artifacts/runs/20260730T210831Z/
!kb_creator/output/innsmouth_source_to_artifacts/runs/20260730T210831Z/The_Innsmouth_Terror_Full_RU.html
!kb_creator/output/innsmouth_source_to_artifacts/runs/20260730T210831Z/For_Keeper/
!kb_creator/output/innsmouth_source_to_artifacts/runs/20260730T210831Z/For_Keeper/KeeperBook.md
!kb_creator/pdf_raw/
!kb_creator/pdf_raw/*.py

# Never tracked: run roots, local tools/runtime, caches and machine-local state.
kb_creator/working/
.tools/
.venv/
runtime.local.json
**/runtime.local.json
__pycache__/
*.py[cod]
.pytest_cache/
*.sqlite
*.sqlite-shm
*.sqlite-wal
.obsidian/
**/*BACKUP*/
**/*backup*/

# PDFs: source books stay outside Git (see the source registry); only the
# listed frozen RU release/production PDFs are tracked, through Git LFS.
*.pdf
*.PDF
!kb_creator/inputs/innsmouth/pdf/**/*.pdf
!kb_creator/inputs/viral/production/Viral_RU.pdf
!kb_creator/inputs/number-7-dream/production/Number_7_Dream_RU.pdf
!kb_creator/inputs/number-7-dream/review-history/run29/Number_7_Dream_RU.pdf
!kb_creator/inputs/number-7-dream/revisions/**/*.pdf
