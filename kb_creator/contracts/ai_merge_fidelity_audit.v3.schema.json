{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.ai_merge_fidelity_audit.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorities",
    "policy",
    "pages",
    "errors",
    "passed"
  ],
  "properties": {
    "schema": {
      "const": "kb_creator.ai-merge-fidelity-audit/v3"
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_identity_sha256",
        "bridge_sha256",
        "submission_sha256",
        "review_queue",
        "comparison",
        "geometry",
        "visual_manifest",
        "decision_set",
        "reviewed_allowlist",
        "packets"
      ],
      "properties": {
        "run_identity_sha256": {
          "$ref": "#/$defs/sha"
        },
        "bridge_sha256": {
          "$ref": "#/$defs/sha"
        },
        "submission_sha256": {
          "$ref": "#/$defs/sha"
        },
        "review_queue": {
          "$ref": "#/$defs/ref"
        },
        "comparison": {
          "$ref": "#/$defs/ref"
        },
        "geometry": {
          "$ref": "#/$defs/ref"
        },
        "visual_manifest": {
          "$ref": "#/$defs/ref"
        },
        "decision_set": {
          "$ref": "#/$defs/ref"
        },
        "reviewed_allowlist": {
          "$ref": "#/$defs/ref"
        },
        "packets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page_ref"
          }
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_completeness_threshold",
            "selected_recall_threshold",
            "required_views",
            "normalization",
            "low_text_exemption",
            "visual_assertion_policy",
            "ocr_equivalence_policy",
            "ocr_min_iou",
            "ocr_max_center_distance",
            "ocr_max_token_levenshtein",
            "ocr_max_string_levenshtein",
            "ocr_min_similarity",
            "canonical_geometry_policy",
            "whole_unit_equivalence_policy",
            "subspan_equivalence_policy",
            "subspan_min_smaller_box_coverage",
            "running_furniture_policy",
            "running_furniture_max_y",
            "running_furniture_min_iou",
            "running_furniture_max_center_distance",
            "running_furniture_max_levenshtein",
            "running_furniture_min_similarity"
          ],
          "properties": {
            "source_completeness_threshold": {
              "const": 1.0
            },
            "selected_recall_threshold": {
              "const": 0.95
            },
            "required_views": {
              "const": [
                "original_pipeline_txt",
                "original_pipeline_ocr",
                "raster_pipeline_ocr"
              ]
            },
            "normalization": {
              "type": "string"
            },
            "low_text_exemption": {
              "const": false
            },
            "visual_assertion_policy": {
              "type": "string"
            },
            "ocr_equivalence_policy": {
              "type": "string"
            },
            "ocr_min_iou": {
              "type": "number"
            },
            "ocr_max_center_distance": {
              "type": "number"
            },
            "ocr_max_token_levenshtein": {
              "type": "integer"
            },
            "ocr_max_string_levenshtein": {
              "type": "integer"
            },
            "ocr_min_similarity": {
              "type": "number"
            },
            "canonical_geometry_policy": {
              "const": "source_displayed_mediabox_affine_v1"
            },
            "whole_unit_equivalence_policy": {
              "const": "exact_unique_cross_view_geometry_v2"
            },
            "subspan_equivalence_policy": {
              "const": "exact_unique_selected_context_geometry_v1"
            },
            "subspan_min_smaller_box_coverage": {
              "const": 0.8
            },
            "running_furniture_policy": {
              "const": "reviewed_multi_page_top_margin_v1"
            },
            "running_furniture_max_y": {
              "const": 0.06
            },
            "running_furniture_min_iou": {
              "const": 0.8
            },
            "running_furniture_max_center_distance": {
              "const": 0.01
            },
            "running_furniture_max_levenshtein": {
              "const": 1
            },
            "running_furniture_min_similarity": {
              "const": 0.92
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_completeness_threshold",
            "selected_recall_threshold",
            "required_views",
            "normalization",
            "low_text_exemption",
            "visual_assertion_policy",
            "ocr_equivalence_policy",
            "ocr_min_iou",
            "ocr_max_center_distance",
            "ocr_max_token_levenshtein",
            "ocr_max_string_levenshtein",
            "ocr_min_similarity",
            "canonical_geometry_policy",
            "whole_unit_equivalence_policy",
            "subspan_equivalence_policy",
            "subspan_min_smaller_box_coverage",
            "running_furniture_policy",
            "running_furniture_max_y",
            "running_furniture_min_iou",
            "running_furniture_max_center_distance",
            "running_furniture_max_levenshtein",
            "running_furniture_min_similarity",
            "subspan_max_other_box_overlap",
            "running_furniture_allow_mirrored_parity"
          ],
          "properties": {
            "source_completeness_threshold": {
              "const": 1.0
            },
            "selected_recall_threshold": {
              "const": 0.95
            },
            "required_views": {
              "const": [
                "original_pipeline_txt",
                "original_pipeline_ocr",
                "raster_pipeline_ocr"
              ]
            },
            "normalization": {
              "type": "string"
            },
            "low_text_exemption": {
              "const": false
            },
            "visual_assertion_policy": {
              "type": "string"
            },
            "ocr_equivalence_policy": {
              "type": "string"
            },
            "ocr_min_iou": {
              "type": "number"
            },
            "ocr_max_center_distance": {
              "type": "number"
            },
            "ocr_max_token_levenshtein": {
              "type": "integer"
            },
            "ocr_max_string_levenshtein": {
              "type": "integer"
            },
            "ocr_min_similarity": {
              "type": "number"
            },
            "canonical_geometry_policy": {
              "const": "source_displayed_mediabox_affine_v1"
            },
            "whole_unit_equivalence_policy": {
              "const": "exact_unique_cross_view_geometry_v2"
            },
            "subspan_equivalence_policy": {
              "const": "exact_unique_selected_context_geometry_v2"
            },
            "subspan_min_smaller_box_coverage": {
              "const": 0.8
            },
            "running_furniture_policy": {
              "const": "reviewed_multi_page_top_margin_v2"
            },
            "running_furniture_max_y": {
              "const": 0.12
            },
            "running_furniture_min_iou": {
              "const": 0.8
            },
            "running_furniture_max_center_distance": {
              "const": 0.01
            },
            "running_furniture_max_levenshtein": {
              "const": 1
            },
            "running_furniture_min_similarity": {
              "const": 0.92
            },
            "subspan_max_other_box_overlap": {
              "const": 0.1
            },
            "running_furniture_allow_mirrored_parity": {
              "const": true
            }
          }
        }
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "queue_sha256": {
          "$ref": "#/$defs/sha"
        },
        "comparison_sha256": {
          "$ref": "#/$defs/sha"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "additionalProperties": false
    },
    "page_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_page",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_page",
        "required_character_count",
        "covered_character_count",
        "completeness",
        "ordered_proof_stream",
        "units",
        "visual_assertions",
        "ocr_equivalence_classes",
        "unaccounted_unit_count",
        "errors",
        "passed"
      ],
      "properties": {
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "required_character_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_character_count": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "type": "number",
          "minimum": 0
        },
        "ordered_proof_stream": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "visual_assertions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ocr_equivalence_classes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_page_renders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_page_render_proof"
          }
        },
        "unaccounted_unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "source_page_render_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "logical_name", "source_page", "render"],
      "properties": {
        "origin": {"const": "source_pdf_page_render_v1"},
        "logical_name": {"type": "string", "minLength": 1},
        "source_page": {"type": "integer", "minimum": 1},
        "render": {"$ref": "#/$defs/source_page_render"}
      }
    },
    "source_page_render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "dpi", "renderer_sha256", "pixels", "bytes", "sha256"],
      "properties": {
        "recipe": {"const": "pdftoppm-mediabox-single-page-png-v1"},
        "dpi": {"type": "integer", "minimum": 1},
        "renderer_sha256": {"$ref": "#/$defs/sha"},
        "pixels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
