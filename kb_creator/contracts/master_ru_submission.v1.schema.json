{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.master_ru_submission.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scenario_id", "accepted_master_en", "packet_manifest", "units", "batches", "review", "submission_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.master_ru_submission.v1"}, "scenario_id": {"type": "string", "minLength": 1},
    "accepted_master_en": {"$ref": "#/$defs/file"}, "packet_manifest": {"$ref": "#/$defs/file"},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "source_sha256", "russian_payload_sha256"], "properties": {"unit_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}, "russian_payload_sha256": {"$ref": "#/$defs/sha256"}}}},
    "batches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "review": {"type": "object", "additionalProperties": false, "required": ["state", "unresolved"], "properties": {"state": {"const": "closed"}, "unresolved": {"const": []}}},
    "submission_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
