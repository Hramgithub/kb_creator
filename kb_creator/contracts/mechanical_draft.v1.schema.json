{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.mechanical_draft.v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "state", "authority", "run_root", "authorities", "stage04_visual_manifest", "page_count", "pages", "diagnostics", "review_flags", "unresolved_hold_count", "ruleset_version", "manifest_sha256"],
  "properties": {"schema": {"const": "kb_creator.mechanical_draft.v1"}, "state": {"const": "mechanical_candidate_requires_review"}, "authority": {"type": "string", "minLength": 1}, "run_root": {"type": "string", "minLength": 1}, "authorities": {"$ref": "#/$defs/authorities"}, "stage04_visual_manifest": {"$ref": "#/$defs/identity"}, "page_count": {"type": "integer", "minimum": 1}, "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page_manifest"}}, "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}, "review_flags": {"const": {"visual_reviewed": false, "accepted": false}}, "unresolved_hold_count": {"type": "integer", "minimum": 0}, "ruleset_version": {"const": "mechanical-reconstruction.v1"}, "manifest_sha256": {"$ref": "#/$defs/sha"}},
  "$defs": {
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}},
    "bound": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "authorities": {"type": "object", "additionalProperties": false, "required": ["validator_route", "run", "source", "prepared_manifest", "comparison", "visual_manifest", "replay"], "properties": {"validator_route": {"enum": ["native", "replay"]}, "run": {"$ref": "#/$defs/bound"}, "source": {"$ref": "#/$defs/source"}, "prepared_manifest": {"$ref": "#/$defs/bound"}, "comparison": {"$ref": "#/$defs/bound"}, "visual_manifest": {"$ref": "#/$defs/bound"}, "replay": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["bridge", "completion"], "properties": {"bridge": {"$ref": "#/$defs/bound"}, "completion": {"$ref": "#/$defs/bound"}}}]}}},
    "source_key": {"type": "object", "additionalProperties": false, "required": ["view", "raw_index"], "properties": {"view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "raw_index": {"type": "integer", "minimum": 0}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start_line", "end_line", "sha256"], "properties": {"start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "alternative": {"type": "object", "additionalProperties": false, "required": ["view", "blocks"], "properties": {"view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "blocks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["raw_index", "type", "bbox", "text", "text_sha256", "assets", "table_body_sha256", "semantic_evidence"], "properties": {"raw_index": {"type": "integer", "minimum": 0}, "type": {"type": "string"}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "text": {"type": "string"}, "text_sha256": {"$ref": "#/$defs/sha"}, "assets": {"type": "array", "items": {"type": "string"}}, "table_body_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "semantic_evidence": {"type": "object"}}}}}},
    "offset": {"type": "object", "additionalProperties": false, "required": ["view", "raw_index", "field", "source_sha256", "start", "end"], "properties": {"view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "raw_index": {"type": "integer", "minimum": 0}, "field": {"enum": ["text", "table_body"]}, "source_sha256": {"$ref": "#/$defs/sha"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "asset_binding": {"type": "object", "additionalProperties": false, "required": ["view", "raw_index", "source_path", "logical_name"], "properties": {"view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "raw_index": {"type": "integer", "minimum": 0}, "source_path": {"type": "string", "minLength": 1}, "logical_name": {"type": "string", "minLength": 1}}},
    "unit": {"type": "object", "additionalProperties": false, "required": ["kind", "source_offsets", "asset_bindings", "reader_span"], "properties": {"kind": {"enum": ["paragraph", "table", "asset"]}, "source_offsets": {"type": "array", "items": {"$ref": "#/$defs/offset"}}, "asset_bindings": {"type": "array", "items": {"$ref": "#/$defs/asset_binding"}}, "reader_span": {"$ref": "#/$defs/span"}}, "allOf": [{"if": {"properties": {"kind": {"const": "asset"}}}, "then": {"properties": {"source_offsets": {"maxItems": 0}, "asset_bindings": {"minItems": 1}}}, "else": {"properties": {"source_offsets": {"minItems": 1}}}}]},
    "entry": {"type": "object", "additionalProperties": false, "required": ["ordinal", "chosen_view", "raw_index", "source_keys", "alternatives", "source_text_sha256", "assets", "table_body_sha256", "disposition"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "chosen_view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "raw_index": {"type": "integer", "minimum": 0}, "source_keys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_key"}}, "alternatives": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/alternative"}}, "source_text_sha256": {"$ref": "#/$defs/sha"}, "assets": {"type": "array", "items": {"type": "string"}}, "table_body_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "disposition": {"enum": ["emitted", "hold", "excluded_empty"]}, "rule": {"type": "string"}, "correction": {}, "reader_span": {"$ref": "#/$defs/span"}, "reader_text": {"type": "string"}, "assets_emitted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_path", "logical_name"], "properties": {"source_path": {"type": "string"}, "logical_name": {"type": "string"}}}}, "unit": {"$ref": "#/$defs/unit"}}},
    "page_candidate": {"type": "object", "additionalProperties": false, "required": ["source_page", "semantic_role", "review", "markdown", "entries", "unresolved"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "semantic_role": {}, "review": {"const": {"visual_reviewed": false, "state": "mechanical_candidate"}}, "markdown": {"type": "string"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}, "unresolved": {"type": "array", "items": {"type": "string"}}}},
    "page_manifest": {"type": "object", "additionalProperties": false, "required": ["source_page", "packet", "candidate"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "packet": {"$ref": "#/$defs/bound"}, "candidate": {"$ref": "#/$defs/bound"}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "page", "source_keys", "alternatives", "expected", "observed", "next_action"], "properties": {"code": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}, "source_keys": {"type": "array", "items": {"$ref": "#/$defs/source_key"}}, "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}}, "expected": {}, "observed": {}, "next_action": {"type": "string", "minLength": 1}}}
  }
}
