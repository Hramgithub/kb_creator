{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.mineru_geometry_failure.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "policy", "inputs", "renderer", "review_dpi", "succeeded_views", "first_mismatch", "observed_geometry", "outputs_created", "failure_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.mineru_geometry_failure.v1"}, "policy": {"const": "source_displayed_mediabox_v1"},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["raw_receipt", "source", "comparison", "raw_root", "dpi", "preparation_manifest"], "properties": {"raw_receipt": {"$ref": "#/$defs/input_identity"}, "source": {"$ref": "#/$defs/input_identity"}, "comparison": {"$ref": "#/$defs/input_identity"}, "raw_root": {"type": "string", "minLength": 1}, "dpi": {"type": "integer", "minimum": 1}, "preparation_manifest": {"$ref": "#/$defs/input_identity"}, "reconstruction_contract": {"$ref": "#/$defs/input_identity"}}},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256", "version", "argv_recipe"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "version": {"type": "string", "minLength": 1}, "argv_recipe": {"const": "pdftoppm-mediabox-png-v1"}}},
    "review_dpi": {"type": "integer", "minimum": 1}, "succeeded_views": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true}, "first_mismatch": {"type": "object"}, "observed_geometry": {"type": "array"},
    "outputs_created": {"const": []}, "failure_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "input_identity": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}}
}
