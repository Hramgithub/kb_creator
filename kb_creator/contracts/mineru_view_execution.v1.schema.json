{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.mineru_view_execution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "view_id", "required", "provider_id", "run_identity_sha256", "input", "execution_profile", "capability_snapshot", "provider_verification", "profile_identity", "state", "reason_code", "artifact_root", "output_inventory", "page_coverage", "exit_code", "diagnostics", "blocked_by", "cache_key", "receipt_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.mineru_view_execution.v1"},
    "view_id": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr", "original_hybrid_high", "original_vlm"]},
    "required": {"type": "boolean"},
    "provider_id": {"enum": ["pipeline_cpu", "hybrid_cuda", "vlm_cuda"]},
    "run_identity_sha256": {"$ref": "#/$defs/sha256"},
    "input": {"oneOf": [{"$ref": "#/$defs/original_input"}, {"$ref": "#/$defs/raster_input"}]},
    "execution_profile": {"type": "object", "additionalProperties": false, "required": ["view_id", "required", "provider_id", "input_kind", "backend", "method", "effort", "formula", "table", "ocr_language", "argv_shape_version"], "properties": {"view_id": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr", "original_hybrid_high", "original_vlm"]}, "required": {"type": "boolean"}, "provider_id": {"enum": ["pipeline_cpu", "hybrid_cuda", "vlm_cuda"]}, "input_kind": {"enum": ["original", "raster"]}, "backend": {"enum": ["pipeline", "hybrid-engine", "vlm-engine"]}, "method": {"enum": ["txt", "ocr", null]}, "effort": {"enum": ["high", null]}, "formula": {"const": true}, "table": {"const": true}, "ocr_language": {"type": "string", "minLength": 1}, "argv_shape_version": {"const": 1}}},
    "capability_snapshot": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256", "receipt_sha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256_lower"}, "receipt_sha256": {"$ref": "#/$defs/sha256_lower"}}},
    "provider_verification": {"oneOf": [{"$ref": "#/$defs/lower_receipt_identity"}, {"type": "null"}]}, "profile_identity": {"type": ["object", "null"]},
    "state": {"enum": ["succeeded", "skipped"]}, "reason_code": {"type": ["string", "null"]},
    "artifact_root": {"type": ["string", "null"]}, "output_inventory": {"type": "array", "items": {"$ref": "#/$defs/file_record"}},
    "page_coverage": {"oneOf": [{"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, {"type": "null"}]}, "exit_code": {"const": 0}, "diagnostics": {"type": "object"},
    "blocked_by": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["provider_id", "capability_receipt_sha256"], "properties": {"provider_id": {"enum": ["hybrid_cuda", "vlm_cuda"]}, "capability_receipt_sha256": {"$ref": "#/$defs/sha256_lower"}}}, {"type": "null"}]}, "cache_key": {"$ref": "#/$defs/sha256"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {"properties": {"state": {"const": "skipped"}, "required": {"const": false}, "provider_verification": {"type": "null"}, "profile_identity": {"type": "null"}, "artifact_root": {"type": "null"}, "output_inventory": {"const": []}, "page_coverage": {"type": "null"}, "diagnostics": {"const": {"invoked": false}}, "blocked_by": {"type": "object"}}},
    {"properties": {"state": {"const": "succeeded"}, "reason_code": {"type": "null"}, "provider_verification": {"type": "object"}, "profile_identity": {"type": "object"}, "artifact_root": {"type": "string", "pattern": "^views/[A-Za-z0-9._-]+/artifacts$"}, "output_inventory": {"minItems": 5}, "page_coverage": {"type": "array"}, "blocked_by": {"type": "null"}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "sha256_lower": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_record": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "lower_receipt_identity": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256", "receipt_sha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256_lower"}, "receipt_sha256": {"$ref": "#/$defs/sha256_lower"}}},
    "original_input": {"type": "object", "additionalProperties": false, "required": ["kind", "path_hint", "bytes", "sha256", "source_sha256"], "properties": {"kind": {"const": "original"}, "path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
    "raster_input": {"type": "object", "additionalProperties": false, "required": ["kind", "path_hint", "bytes", "sha256", "source_sha256", "preparation_manifest"], "properties": {"kind": {"const": "raster"}, "path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "preparation_manifest": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}}
  }
}
