{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.publication_run_spec.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "target", "profile", "scenario_id", "contract", "accepted_reconstruction", "stage_graph", "configs", "adapters", "tools", "implementation", "portable_identity_sha256", "local"],
  "properties": {
    "schema": {"const": "kb_creator.publication_run_spec.v1"}, "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "target": {"const": "production_candidate"}, "profile": {"const": "scenario_publication_v1"}, "scenario_id": {"type": "string", "minLength": 1},
    "contract": {"$ref": "#/$defs/file"},
    "accepted_reconstruction": {"type": "object", "additionalProperties": false, "required": ["inventory", "acceptance"], "properties": {"inventory": {"$ref": "#/$defs/file"}, "acceptance": {"$ref": "#/$defs/file"}}},
    "stage_graph": {"const": ["master_en_candidate", "master_ru_packets", "master_ru_candidate", "artview_bundle", "artview_apply", "html_candidate", "docx_candidate", "pdf_candidate", "production_package", "offline_verify"]},
    "configs": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/named_file"}},
    "adapters": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/adapter"}},
    "tools": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "scope"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "scope": {"enum": ["repository_tools", "allowed_system", "injected_test"]}}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["files", "inventory_sha256"], "properties": {"files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}, "inventory_sha256": {"$ref": "#/$defs/sha256"}}},
    "portable_identity_sha256": {"$ref": "#/$defs/sha256"},
    "local": {"type": "object", "additionalProperties": false, "required": ["repo_root", "run_root", "contract_path", "upstream_inventory_path", "reconstruction_acceptance_path", "config_root", "tools_root"], "properties": {"repo_root": {"type": "string", "minLength": 1}, "run_root": {"type": "string", "minLength": 1}, "contract_path": {"type": "string", "minLength": 1}, "upstream_inventory_path": {"type": "string", "minLength": 1}, "reconstruction_acceptance_path": {"type": "string", "minLength": 1}, "config_root": {"type": "string", "minLength": 1}, "tools_root": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "named_file": {"type": "object", "additionalProperties": false, "required": ["role", "file"], "properties": {"role": {"type": "string", "minLength": 1}, "file": {"$ref": "#/$defs/file"}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["stage", "logical_name", "version"], "properties": {"stage": {"type": "string", "minLength": 1}, "logical_name": {"type": "string", "minLength": 1}, "version": {"const": 1}}}
  }
}
