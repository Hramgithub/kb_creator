{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.reconstruction_source_identity.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "run_identity_sha256", "contract", "source", "source_identity_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.reconstruction_source_identity.v3"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "run_identity_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["basename", "bytes", "sha256", "contract_revision"], "properties": {"basename": {"type": "string", "pattern": "^[^/:\\\\]+$"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "contract_revision": {"const": 3}}},
    "source": {"oneOf": [{"$ref": "#/$defs/scalar_source"}, {"$ref": "#/$defs/per_page_source"}]},
    "source_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_common": {"type": "object", "properties": {"basename": {"type": "string", "pattern": "^[^/:\\\\]+$"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "page_count": {"type": "integer", "minimum": 1}}},
    "scalar_source": {"allOf": [{"$ref": "#/$defs/source_common"}, {"type": "object", "required": ["basename", "bytes", "sha256", "page_count", "media_box_points", "rotation_degrees"], "properties": {"media_box_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}, "rotation_degrees": {"enum": [0, 90, 180, 270]}}}], "unevaluatedProperties": false},
    "per_page_source": {"allOf": [{"$ref": "#/$defs/source_common"}, {"type": "object", "required": ["basename", "bytes", "sha256", "page_count", "page_geometry"], "properties": {"page_geometry": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_page", "media_box_coordinates", "crop_box_coordinates", "rotation_degrees", "user_unit"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "media_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "crop_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "rotation_degrees": {"enum": [0, 90, 180, 270]}, "user_unit": {"const": 1}}}}}}], "unevaluatedProperties": false}
  }
}
