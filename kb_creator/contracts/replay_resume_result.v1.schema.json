{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.replay_resume_result.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "state", "run_identity_sha256", "bridge_sha256", "submission_sha256", "stages", "candidate_root", "acceptance_inferred", "exit_code"],
  "properties": {"schema": {"const": "kb_creator.replay_resume_result.v1"}, "state": {"const": "candidate_ready_for_reconstruction_qa"}, "run_identity_sha256": {"$ref": "#/$defs/sha"}, "bridge_sha256": {"$ref": "#/$defs/sha"}, "submission_sha256": {"$ref": "#/$defs/sha"}, "stages": {"type": "array", "prefixItems": [{"$ref": "#/$defs/stage"}, {"$ref": "#/$defs/stage"}], "items": false}, "candidate_root": {"const": "outputs/06-materialize-candidate"}, "acceptance_inferred": {"const": false}, "exit_code": {"const": 0}},
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "stage": {"type": "object", "additionalProperties": false, "required": ["stage_id", "manifest_sha256", "output_inventory_sha256"], "properties": {"stage_id": {"type": "string"}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "output_inventory_sha256": {"$ref": "#/$defs/sha"}}}}
}
