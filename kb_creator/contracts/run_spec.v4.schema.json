{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.run_spec.v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "target", "profile", "contract", "source", "scope", "options", "execution_boundary", "view_plan", "capability_snapshot", "provider_profiles", "common_tools", "toolchain", "implementation", "portable_identity_sha256", "local"],
  "properties": {
    "schema": {"const": "kb_creator.run_spec.v4"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "target": {"const": "reconstructed_en"},
    "profile": {"const": "mineru_cpu_first_three_view_v1"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["path_hint", "bytes", "sha256", "contract_revision"],
      "properties": {
        "path_hint": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "contract_revision": {"const": 3}
      }
    },
    "source": {"oneOf": [{"$ref": "#/$defs/scalar_source"}, {"$ref": "#/$defs/per_page_source"}]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["ordered_pages"], "properties": {"ordered_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}},
    "options": {"type": "object"},
    "execution_boundary": {"const": {"mode": "current_station_local_only", "remote_endpoints_allowed": false, "external_services_allowed": false, "user_executable_allowed": false}},
    "view_plan": {"type": "array", "minItems": 5, "maxItems": 5},
    "capability_snapshot": {"type": "object"},
    "provider_profiles": {"type": "object"},
    "common_tools": {"type": "object"},
    "toolchain": {"type": "array", "minItems": 6, "maxItems": 6},
    "implementation": {"$ref": "#/$defs/inventory"},
    "portable_identity_sha256": {"$ref": "#/$defs/sha256"},
    "local": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_common": {
      "type": "object", "properties": {
        "path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "scalar_source": {
      "allOf": [{"$ref": "#/$defs/source_common"}, {"type": "object", "required": ["path_hint", "bytes", "sha256", "page_count", "media_box_points", "rotation_degrees"], "properties": {"media_box_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}, "rotation_degrees": {"enum": [0, 90, 180, 270]}}}], "unevaluatedProperties": false
    },
    "per_page_source": {
      "allOf": [{"$ref": "#/$defs/source_common"}, {"type": "object", "required": ["path_hint", "bytes", "sha256", "page_count", "page_geometry"], "properties": {"page_geometry": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_page", "media_box_coordinates", "crop_box_coordinates", "rotation_degrees", "user_unit"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "media_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "crop_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "rotation_degrees": {"enum": [0, 90, 180, 270]}, "user_unit": {"const": 1}}}}}}], "unevaluatedProperties": false
    },
    "inventory": {"type": "object", "additionalProperties": false, "required": ["files", "inventory_sha256"], "properties": {"files": {"type": "array", "minItems": 1}, "inventory_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
