{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.scenario_artview_decisions.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "state", "bindings", "decisions", "review", "decisions_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.scenario_artview_decisions.v3"},
    "scenario_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["draft", "accepted"]},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_manifest_sha256", "candidate_files_inventory_sha256", "profile_sha256", "master_ru_sha256", "master_ru_acceptance_sha256", "master_ru_asset_manifest_sha256", "reconstruction_inventory_sha256"],
      "properties": {
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"}, "candidate_files_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}, "master_ru_sha256": {"$ref": "#/$defs/sha256"},
        "master_ru_acceptance_sha256": {"$ref": "#/$defs/sha256"}, "master_ru_asset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "reconstruction_inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "binary", "presentation", "reviewed", "notes"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "binary": {"type": "object", "additionalProperties": false, "required": ["choice", "candidate_id"], "properties": {"choice": {"enum": [null, "keep_current", "use_candidate", "exclude", "needs_manual_work", "reopen_masters"]}, "candidate_id": {"type": ["string", "null"]}}},
          "presentation": {"$ref": "#/$defs/presentation"},
          "reviewed": {"type": "boolean"}, "notes": {"type": "string"}
        }
      }
    },
    "review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewed_count", "unresolved_asset_ids"], "properties": {"state": {"enum": ["open", "closed"]}, "reviewed_count": {"type": "integer", "minimum": 0}, "unresolved_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "decisions_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "accepted"}}}, "then": {"properties": {"review": {"properties": {"state": {"const": "closed"}, "unresolved_asset_ids": {"maxItems": 0}}}}}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["width_percent", "alignment", "wrap_text", "wrap_tables"], "properties": {"width_percent": {"type": "integer", "minimum": 10, "maximum": 100}, "alignment": {"enum": ["left", "center", "right"]}, "wrap_text": {"type": "boolean"}, "wrap_tables": {"type": "boolean"}}}
  }
}
