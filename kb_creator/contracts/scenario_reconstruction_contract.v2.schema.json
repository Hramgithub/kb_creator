{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.scenario_reconstruction_contract.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "scenario",
    "source",
    "scope",
    "page_roles",
    "reconstruction",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "const": "kb_creator.scenario_reconstruction_contract.v2"
    },
    "contract_revision": {
      "const": 2
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_count",
        "page_count",
        "page_geometry"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "page_geometry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_page",
              "media_box_coordinates",
              "crop_box_coordinates",
              "rotation_degrees",
              "user_unit"
            ],
            "properties": {
              "source_page": {
                "type": "integer",
                "minimum": 1
              },
              "media_box_coordinates": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "crop_box_coordinates": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "rotation_degrees": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "user_unit": {
                "const": 1
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "first_page",
        "last_page",
        "required_entities"
      ],
      "properties": {
        "mode": {
          "const": "all_source_pages"
        },
        "first_page": {
          "type": "integer",
          "minimum": 1
        },
        "last_page": {
          "type": "integer",
          "minimum": 1
        },
        "required_entities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numbered_player_handouts"
          ],
          "properties": {
            "numbered_player_handouts": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "page_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "first_page",
          "last_page",
          "content_mode",
          "traits",
          "strategies"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "first_page": {
            "type": "integer",
            "minimum": 1
          },
          "last_page": {
            "type": "integer",
            "minimum": 1
          },
          "content_mode": {
            "enum": [
              "text",
              "mixed",
              "visual",
              "unknown"
            ]
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "strategies": {
            "type": "array",
            "items": {
              "enum": [
                "embedded_text",
                "reading_order",
                "ocr_region",
                "visual_preserve"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategies",
        "required_review"
      ],
      "properties": {
        "strategies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "embedded_text",
              "reading_order",
              "ocr_region",
              "visual_preserve"
            ]
          },
          "uniqueItems": true
        },
        "required_review": {
          "const": true
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_authority"
      ],
      "properties": {
        "approval_authority": {
          "const": "configured_reconstruction_review"
        }
      }
    }
  }
}
