{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.mineru_geometry_plan.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "policy", "run_identity_sha256", "preparation_manifest", "source", "comparison", "view_set", "review_dpi", "rounding_rule", "tolerances", "renderer", "succeeded_views", "layouts", "observed_geometry", "targets", "transforms", "rendered_pages", "plan_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.mineru_geometry_plan.v1"}, "policy": {"const": "source_displayed_mediabox_v1"},
    "run_identity_sha256": {"$ref": "#/$defs/sha"}, "preparation_manifest": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}, "comparison": {"$ref": "#/$defs/identity"},
    "view_set": {"$ref": "#/$defs/sealed_identity"}, "review_dpi": {"type": "integer", "minimum": 1}, "rounding_rule": {"const": "ceil(points*dpi/72)"},
    "tolerances": {"const": {"dimension_points": "0.001", "relative_aspect_ratio": "0.000005", "pixels": 0}},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256", "version", "argv_recipe"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "version": {"type": "string", "minLength": 1}, "argv_recipe": {"const": "pdftoppm-mediabox-png-v1"}}},
    "succeeded_views": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "layouts": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/layout"}}, "observed_geometry": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/observed"}},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}, "transforms": {"const": {"pad": false, "crop": false, "post_render_resize": false}},
    "rendered_pages": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/rendered"}}, "plan_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "sealed_identity": {"type": "object", "additionalProperties": false, "required": ["path_hint", "bytes", "sha256", "receipt_sha256"], "properties": {"path_hint": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "receipt_sha256": {"$ref": "#/$defs/sha"}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["view_id", "input_kind", "page_count", "layout"], "properties": {"view_id": {"type": "string", "minLength": 1}, "input_kind": {"enum": ["original", "raster"]}, "page_count": {"type": "integer", "minimum": 1}, "layout": {"$ref": "#/$defs/identity"}}},
    "observed": {"type": "object", "additionalProperties": false, "required": ["view_id", "sample_page", "source_page", "media_box_coordinates", "crop_box_coordinates", "rotation_degrees", "user_unit", "effective_displayed_size_points"], "properties": {"view_id": {"type": "string", "minLength": 1}, "sample_page": {"type": "integer", "minimum": 1}, "source_page": {"type": "integer", "minimum": 1}, "media_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/decimal"}}, "crop_box_coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/decimal"}}, "rotation_degrees": {"enum": [0, 90, 180, 270]}, "user_unit": {"type": "string", "pattern": "^1(?:\\.0+)?$"}, "effective_displayed_size_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/decimal"}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["source_page", "displayed_size_points", "target_pixels"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "displayed_size_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/decimal"}}, "target_pixels": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}}},
    "rendered": {"type": "object", "additionalProperties": false, "required": ["view_id", "source_page", "path", "dimensions", "mode", "bytes", "sha256"], "properties": {"view_id": {"type": "string", "minLength": 1}, "source_page": {"type": "integer", "minimum": 1}, "path": {"type": "string", "minLength": 1}, "dimensions": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}, "mode": {"const": "RGB"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
