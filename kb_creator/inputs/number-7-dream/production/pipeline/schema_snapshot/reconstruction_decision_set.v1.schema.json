{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.reconstruction_decision_set.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_queue_sha256", "contract_sha256", "source_sha256", "decisions", "reviewed_allowlist", "submission_state"],
  "properties": {
    "schema": {"const": "kb_creator.reconstruction_decision_set.v1"},
    "review_queue_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "reviewed_allowlist": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
    "submission_state": {"const": "submitted_for_validation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_page", "path", "bytes", "sha256"],
      "properties": {
        "source_page": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "pattern": "^pages/page-[0-9]{3,}\\.json$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

