{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.run_skip.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "run_identity_sha256", "capability", "stages", "skip_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.run_skip.v1"},
    "state": {"const": "skipped"},
    "run_identity_sha256": {"$ref": "#/$defs/sha256"},
    "capability": {"$ref": "#/$defs/capability"},
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "stage_name", "state", "reason_code", "blocked_by"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "stage_name": {"enum": ["prepare_inputs", "mineru_three_view", "compare_views", "visual_merge_bundle", "fidelity_audit", "materialize_candidate"]},
          "state": {"const": "skipped"},
          "reason_code": {"type": "string", "minLength": 1},
          "blocked_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "skip_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "state", "reason_code", "receipt"],
      "properties": {
        "schema": {"const": "nri.mineru_cuda_capability.v1"},
        "state": {"const": "unavailable"},
        "reason_code": {"type": "string", "minLength": 1},
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_hint", "bytes", "sha256"],
          "properties": {
            "path_hint": {"const": "capability.json"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
