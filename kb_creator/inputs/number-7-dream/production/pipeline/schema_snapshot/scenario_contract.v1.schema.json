{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.scenario_contract.v1",
  "title": "ScenarioContract.v1",
  "oneOf": [
    {"$ref": "#/$defs/runtimeContract"},
    {"$ref": "#/$defs/shadowContract"}
  ],
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "product_type", "source_language", "publication_languages"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "product_type": {"const": "coc_scenario"},
        "source_language": {"const": "en"},
        "publication_languages": {"const": ["en", "ru"]}
      }
    },
    "runtimeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity_status", "locator_hint", "sha256", "byte_count", "page_count", "page_number_base", "media_box_points", "rotation_degrees"],
      "properties": {
        "kind": {"const": "external_pdf"},
        "identity_status": {"const": "complete"},
        "locator_hint": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.pdf$"},
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "page_number_base": {"type": "integer", "minimum": 1},
        "media_box_points": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false, "minItems": 2, "maxItems": 2},
        "rotation_degrees": {"enum": [0, 90, 180, 270]}
      }
    },
    "shadowSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity_status", "locator_hint", "sha256", "byte_count", "page_count", "page_number_base", "media_box_points", "rotation_degrees"],
      "properties": {
        "kind": {"const": "external_pdf"},
        "identity_status": {"const": "incomplete"},
        "locator_hint": {"type": "null"},
        "sha256": {"type": "null"},
        "byte_count": {"type": "null"},
        "page_count": {"type": "null"},
        "page_number_base": {"type": "null"},
        "media_box_points": {"type": "null"},
        "rotation_degrees": {"type": "null"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "first_page", "last_page", "required_entities"],
      "properties": {
        "mode": {"const": "all_source_pages"},
        "first_page": {"type": "integer", "minimum": 1},
        "last_page": {"type": "integer", "minimum": 1},
        "required_entities": {
          "type": "object", "additionalProperties": false,
          "required": ["numbered_player_handouts"],
          "properties": {"numbered_player_handouts": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "pageRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "first_page", "last_page", "content_mode", "traits", "strategies"],
      "properties": {
        "role": {"enum": ["cover", "credits", "front_matter", "contents", "scenario_body", "player_handouts", "keeper_maps", "pregenerated_investigators", "back_cover"]},
        "first_page": {"type": "integer", "minimum": 1},
        "last_page": {"type": "integer", "minimum": 1},
        "content_mode": {"enum": ["text", "mixed", "visual", "unknown"]},
        "traits": {"type": "array", "uniqueItems": true, "items": {"enum": ["multi_column", "low_text", "zero_text", "table_heavy", "statblock", "form_like"]}},
        "strategies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["embedded_text", "reading_order", "ocr_region", "visual_preserve"]}}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstructed_en", "master_en", "master_ru", "html", "pdf", "production_manifest"],
      "properties": {
        "reconstructed_en": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.md$"},
        "master_en": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.md$"},
        "master_ru": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.md$"},
        "html": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.html$"},
        "pdf": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.pdf$"},
        "production_manifest": {"type": "string", "pattern": "^[^/\\\\:\\x00-\\x1F]+\\.json$"}
      }
    },
    "ordinaryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategies", "required_review"],
      "properties": {
        "strategies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["embedded_text", "reading_order", "ocr_region", "visual_preserve"]}},
        "required_review": {"const": true}
      }
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["reconstruction", "publication", "translation", "visual", "navigation", "render"],
      "properties": {
        "reconstruction": {"$ref": "#/$defs/ordinaryPolicy"},
        "publication": {"const": {"strategies": ["reading_order"], "required_review": true}},
        "translation": {"const": {"strategies": ["reading_order"], "lineage_source": "accepted_current_master_en", "historical_source_mode": "terminology_or_comparison_only", "required_review": true}},
        "visual": {"const": {"strategies": ["visual_preserve"], "required_review": true}},
        "navigation": {"const": {"strategies": ["reading_order"], "required_review": true}},
        "render": {"const": {"strategies": ["visual_preserve"], "profile": "viral_print", "required_review": true}}
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["reconstructed_en", "master_en", "master_ru", "html", "pdf", "production"],
      "properties": {
        "reconstructed_en": {"const": {"automated_gates": ["source_identity", "page_coverage", "role_partition", "text_ocr_provenance", "required_entity_closure", "asset_closure", "no_open_blockers"], "approval_authority": "configured_reconstruction_review"}},
        "master_en": {"const": {"automated_gates": ["accepted_reconstructed", "source_disposition", "semantic_navigation", "handout_mapping", "table_statblock_closure", "asset_closure", "no_technical_reader_noise"], "approval_authority": "explicit_user_reading_acceptance"}},
        "master_ru": {"const": {"automated_gates": ["accepted_master_en_lineage", "structural_parity", "terminology", "untranslated_terms", "links", "asset_closure"], "approval_authority": "explicit_user_reading_acceptance"}},
        "html": {"const": {"automated_gates": ["accepted_master_ru", "deterministic_output", "links", "assets", "unique_ids", "generated_only", "navigation"], "approval_authority": "explicit_user_visual_navigation_acceptance"}},
        "pdf": {"const": {"automated_gates": ["accepted_html", "print_only_delta", "render_coverage", "no_blank_pages", "destinations", "section_boundaries", "full_visual_qa", "generated_only"], "approval_authority": "explicit_user_print_acceptance"}},
        "production": {"const": {"automated_gates": ["accepted_packages", "closed_inventory", "stable_names", "asset_union", "contract_schema_code_snapshots", "qa_closure"], "approval_authority": "explicit_production_snapshot_acceptance"}}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false, "required": ["kind", "value"],
      "properties": {"kind": {"enum": ["exact_text", "block_id", "heading_id", "asset_id", "page_boundary"]}, "value": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
      "properties": {"kind": {"enum": ["source_page", "review_receipt", "accepted_manifest"]}, "ref": {"type": "string", "minLength": 1}}
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "kind", "operation", "scope", "expected_matches", "rationale", "evidence", "approval"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "stage": {"enum": ["reconstructed_en", "master_en", "master_ru", "html", "pdf", "production"]},
        "kind": {"enum": ["text_repair", "reading_order", "list_continuation", "publication_suppression", "semantic_link", "asset_owner", "render_placement", "page_break"]},
        "operation": {"enum": ["replace_exact_text", "reorder_exact_blocks", "continue_numbering", "suppress_exact_block", "retarget_exact_reference", "relocate_exact_asset_owner", "apply_named_placement", "insert_page_break_before_heading"]},
        "scope": {"type": "object", "additionalProperties": false, "required": ["pages", "selector"], "properties": {"pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, "selector": {"$ref": "#/$defs/selector"}}},
        "expected_matches": {"const": 1},
        "rationale": {"type": "string", "minLength": 12},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
        "approval": {"const": "required"}
      }
    },
    "compatibilityEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["control_pdf_sha256", "retained_markdown_candidate_sha256", "reconstructed_page_marker_domain", "accepted_reconstructed_evidence", "accepted_stage_manifests", "authority", "runtime_authority"],
      "properties": {
        "control_pdf_sha256": {"const": {"sha256": "5850B26A077390ABFF4A321E754A3709D6148FA4AC7A9F4D63BDBEFF6949B1BB", "status": "unavailable_control_identity"}},
        "retained_markdown_candidate_sha256": {"const": {"sha256": "1504A9C71CA995748E4125B7303C0D3064E588ABB226EBB5AB99A5F5763C993C", "kind": "retained_markdown_candidate"}},
        "reconstructed_page_marker_domain": {"const": {"kind": "reconstructed_markdown_page_markers", "base": 0, "first": 0, "last": 45, "count": 46}},
        "accepted_reconstructed_evidence": {"const": {
          "reconstructed_markdown": {"byte_count": 138426, "sha256": "8F5A35B6FBE545691EEF66C52A848F0F04776A247CCAAF40B16140FEB0C543BF"},
          "reconstructed_qa": {"byte_count": 75179, "sha256": "8C351053E49AE3546BCA5857394DDCCBA2FF60AE05DA75C03ACB47E076B06DA9"},
          "assets": {"count": 136, "inventory_sha256": "B6F9BF00B01DB09ED06723871B97B424206C5A79EB624C8F5768A847B1CE3B39"}
        }},
        "accepted_stage_manifests": {"const": {
          "master_en": {"root": "inputs/innsmouth/master_en/accepted_20260830_r6", "manifest": "MASTER_EN.acceptance.json", "byte_count": 1320, "sha256": "AD9A6546EB7421F4387A4E6B547B2CD6B61346A3B326D25110A56028FC919B83"},
          "master_ru": {"root": "inputs/innsmouth/master_ru/accepted_20260830_r6", "manifest": "MASTER_RU.acceptance.json", "byte_count": 4075, "sha256": "B87C34F312258FB349B6AE549A398637096CE3A29D9B623EEDA28D5ECF4EC384"},
          "html": {"root": "inputs/innsmouth/html/accepted_20260830_r6", "manifest": "HTML.acceptance.json", "byte_count": 7208, "sha256": "F3A6EC483858060B46EB266893FEE7D4AE4F63D3A9A0A26CCB899D5903B4375A"},
          "pdf": {"root": "inputs/innsmouth/pdf/accepted_20260830_r7", "manifest": "PDF.acceptance.json", "byte_count": 7890, "sha256": "5861569529394C8B04BD7903B1BD07C420812AD63DC1C669F7CA4E11E40E0154"}
        }},
        "authority": {"const": "existing_accepted_manifests_and_verifiers"},
        "runtime_authority": {"const": false}
      }
    },
    "runtimeContract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "contract_revision", "contract_role", "scenario", "source", "scope", "page_roles", "artifacts", "policies", "acceptance", "exceptions"],
      "properties": {
        "schema": {"const": "kb_creator.scenario_contract.v1"}, "contract_revision": {"const": 1}, "contract_role": {"const": "runtime"},
        "scenario": {"$ref": "#/$defs/scenario"}, "source": {"$ref": "#/$defs/runtimeSource"}, "scope": {"$ref": "#/$defs/scope"},
        "page_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageRole"}}, "artifacts": {"$ref": "#/$defs/artifacts"},
        "policies": {"$ref": "#/$defs/policies"}, "acceptance": {"$ref": "#/$defs/acceptance"},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
      }
    },
    "shadowContract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "contract_revision", "contract_role", "scenario", "source", "scope", "page_roles", "artifacts", "policies", "acceptance", "exceptions", "compatibility_evidence"],
      "properties": {
        "schema": {"const": "kb_creator.scenario_contract.v1"}, "contract_revision": {"const": 1}, "contract_role": {"const": "compatibility_shadow"},
        "scenario": {"$ref": "#/$defs/scenario"}, "source": {"$ref": "#/$defs/shadowSource"}, "scope": {"type": "null"},
        "page_roles": {"const": []}, "artifacts": {"$ref": "#/$defs/artifacts"}, "policies": {"type": "null"},
        "acceptance": {"type": "null"}, "exceptions": {"const": []}, "compatibility_evidence": {"$ref": "#/$defs/compatibilityEvidence"}
      }
    }
  }
}
