{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.stage_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reproducible", "execution", "reproducible_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.stage_manifest.v1"},
    "reproducible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "stage_name", "stage_version", "state", "run_identity_sha256", "upstream", "inputs", "options", "adapter", "tools", "implementation_inventory_sha256", "outputs", "evidence", "cache_key"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
        "stage_name": {"enum": ["prepare_inputs", "mineru_three_view", "compare_views", "visual_merge_bundle", "fidelity_audit", "materialize_candidate"]},
        "stage_version": {"const": 1},
        "state": {"const": "succeeded"},
        "run_identity_sha256": {"$ref": "#/$defs/sha256"},
        "upstream": {"type": "array", "items": {"$ref": "#/$defs/upstream"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "options": {"type": "object"},
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_name", "script_sha256", "argv_shape_version"],
          "properties": {
            "logical_name": {"enum": ["prepare_inputs", "mineru_three_view", "compare_views", "visual_merge_bundle", "fidelity_audit", "materialize_candidate"]},
            "script_sha256": {"$ref": "#/$defs/sha256"},
            "argv_shape_version": {"const": 1}
          }
        },
        "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "implementation_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_hint", "files", "inventory_sha256"],
          "properties": {
            "root_hint": {"type": "string", "pattern": "^outputs/[0-9]{2}-[a-z0-9-]+$"},
            "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
            "inventory_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "cache_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at_utc", "completed_at_utc", "exit_code", "structured_diagnostics"],
      "properties": {
        "started_at_utc": {"type": "string", "minLength": 1},
        "completed_at_utc": {"type": "string", "minLength": 1},
        "exit_code": {"const": 0},
        "structured_diagnostics": {"type": "object"}
      }
    },
    "reproducible_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "manifest_sha256"],
      "properties": {"stage_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path_hint", "bytes", "sha256"],
      "properties": {
        "kind": {"enum": ["scenario_reconstruction_contract", "source_pdf", "reconstruction_decision_set", "page_decision", "reviewed_allowlist", "review_queue", "multi_view_comparison", "fidelity_policy", "fidelity_audit"]},
        "path_hint": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {"name": {"const": "injected_adapters"}, "version": {"const": "test"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "path_hint", "bytes", "sha256"],
          "properties": {
            "name": {"enum": ["python", "powershell", "pdftoppm", "mineru", "mineru_initialize"]},
            "path_hint": {"type": "string", "minLength": 1},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
