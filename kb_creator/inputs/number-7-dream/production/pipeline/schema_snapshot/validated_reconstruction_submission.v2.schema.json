{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.validated_reconstruction_submission.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_identity_sha256", "bridge_sha256", "review_queue", "contract_sha256", "source_sha256", "decision_set", "page_decisions", "reviewed_allowlist", "files", "files_sha256", "acceptance_inferred", "submission_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.validated_reconstruction_submission.v2"},
    "run_identity_sha256": {"$ref": "#/$defs/sha"}, "bridge_sha256": {"$ref": "#/$defs/sha"},
    "contract_sha256": {"$ref": "#/$defs/sha"}, "source_sha256": {"$ref": "#/$defs/sha"},
    "review_queue": {"$ref": "#/$defs/queue_ref"},
    "decision_set": {"$ref": "#/$defs/ref"},
    "page_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page_ref"}},
    "reviewed_allowlist": {"$ref": "#/$defs/allow_ref"},
    "files": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "files_sha256": {"$ref": "#/$defs/sha"},
    "acceptance_inferred": {"const": false}, "submission_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "queue_ref": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "queue_sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "queue_sha256": {"$ref": "#/$defs/sha"}}},
    "page_ref": {"type": "object", "additionalProperties": false, "required": ["source_page", "path", "bytes", "sha256"], "properties": {"source_page": {"type": "integer", "minimum": 1}, "path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "allow_ref": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "schema"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "schema": {"const": "kb_creator.ai_merge_fidelity_reviewed_allowlist.v3"}}}
  }
}
