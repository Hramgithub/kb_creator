{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.artifact_acceptance.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scenario_id", "artifact_kind", "candidate", "producer_stage", "evidence", "decision", "decision_at_utc", "user_decision_reference", "recorder_role", "receipt_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.artifact_acceptance.v1"}, "scenario_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["reconstructed_en", "master_en", "master_ru", "artview", "html", "docx", "pdf"]},
    "candidate": {"$ref": "#/$defs/file"}, "producer_stage": {"$ref": "#/$defs/file"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "decision": {"const": "accepted"}, "decision_at_utc": {"type": "string", "minLength": 1},
    "user_decision_reference": {"type": "string", "minLength": 1}, "recorder_role": {"const": "main_orchestrator"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
