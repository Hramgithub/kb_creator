{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kb_creator.publication_stage_manifest.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "reproducible", "execution", "reproducible_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.publication_stage_manifest.v1"},
    "reproducible": {"type": "object", "additionalProperties": false, "required": ["stage_id", "stage_name", "stage_version", "state", "run_identity_sha256", "upstream", "inputs", "adapter", "effective_config", "tools", "implementation_inventory_sha256", "outputs", "evidence", "cache_key"], "properties": {
      "stage_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
      "stage_name": {"enum": ["master_en_candidate", "master_ru_packets", "master_ru_candidate", "artview_bundle", "artview_apply", "html_candidate", "docx_candidate", "pdf_candidate", "production_package", "offline_verify"]},
      "stage_version": {"const": 1}, "state": {"const": "succeeded"}, "run_identity_sha256": {"$ref": "#/$defs/sha256"},
      "upstream": {"type": "array", "items": {"$ref": "#/$defs/upstream"}}, "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_file"}},
      "adapter": {"type": "object", "additionalProperties": false, "required": ["logical_name", "version", "script"], "properties": {"logical_name": {"type": "string", "minLength": 1}, "version": {"const": 1}, "script": {"$ref": "#/$defs/file"}}},
      "effective_config": {"$ref": "#/$defs/file"},
      "tools": {
        "oneOf": [
          {"type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/injected_tool"}], "items": false},
          {
            "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
            "items": {"oneOf": [
              {"$ref": "#/$defs/publication_python_tool"}, {"$ref": "#/$defs/pdftoppm_tool"},
              {"$ref": "#/$defs/powershell_tool"}, {"$ref": "#/$defs/word_tool"}
            ]},
            "allOf": [
              {"contains": {"$ref": "#/$defs/publication_python_tool"}, "minContains": 1, "maxContains": 1},
              {"contains": {"$ref": "#/$defs/pdftoppm_tool"}, "minContains": 1, "maxContains": 1},
              {"contains": {"$ref": "#/$defs/powershell_tool"}, "minContains": 1, "maxContains": 1},
              {"contains": {"$ref": "#/$defs/word_tool"}, "minContains": 1, "maxContains": 1}
            ]
          },
          {
            "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
            "items": {"oneOf": [
              {"$ref": "#/$defs/publication_python_tool"}, {"$ref": "#/$defs/pdftoppm_tool"},
              {"$ref": "#/$defs/libreoffice_tool"}
            ]},
            "allOf": [
              {"contains": {"$ref": "#/$defs/publication_python_tool"}, "minContains": 1, "maxContains": 1},
              {"contains": {"$ref": "#/$defs/pdftoppm_tool"}, "minContains": 1, "maxContains": 1},
              {"contains": {"$ref": "#/$defs/libreoffice_tool"}, "minContains": 1, "maxContains": 1}
            ]
          }
        ]
      },
      "implementation_inventory_sha256": {"$ref": "#/$defs/sha256"},
      "outputs": {"$ref": "#/$defs/inventory"}, "evidence": {"$ref": "#/$defs/inventory"}, "cache_key": {"$ref": "#/$defs/sha256"}
    }},
    "execution": {"type": "object", "additionalProperties": false, "required": ["started_at_utc", "completed_at_utc", "exit_code", "structured_diagnostics"], "properties": {"started_at_utc": {"type": "string", "minLength": 1}, "completed_at_utc": {"type": "string", "minLength": 1}, "exit_code": {"const": 0}, "structured_diagnostics": {"type": "object"}}},
    "reproducible_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "named_file": {"type": "object", "additionalProperties": false, "required": ["kind", "file"], "properties": {"kind": {"type": "string", "minLength": 1}, "file": {"$ref": "#/$defs/file"}}},
    "upstream": {"type": "object", "additionalProperties": false, "required": ["stage_id", "manifest_sha256"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["root", "files", "inventory_sha256"], "properties": {"root": {"type": "string", "minLength": 1}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "inventory_sha256": {"$ref": "#/$defs/sha256"}}},
    "tool_record": {"type": "object", "additionalProperties": false, "required": ["name", "version", "scope"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "scope": {"enum": ["injected_test", "repository_tools", "allowed_system"]}}},
    "injected_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "injected_publication_adapters"}, "version": {"const": "test"}, "scope": {"const": "injected_test"}}}]},
    "publication_python_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "publication_python"}, "version": {"pattern": "^sha256:[0-9A-F]{64}$"}, "scope": {"const": "repository_tools"}}}]},
    "pdftoppm_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "pdftoppm"}, "version": {"pattern": "^sha256:[0-9A-F]{64}$"}, "scope": {"const": "repository_tools"}}}]},
    "powershell_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "powershell"}, "version": {"pattern": "^sha256:[0-9A-F]{64}$"}, "scope": {"const": "allowed_system"}}}]},
    "word_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "microsoft_word_com"}, "version": {"pattern": "^sha256:[0-9A-F]{64}$"}, "scope": {"const": "allowed_system"}}}]},
    "libreoffice_tool": {"allOf": [{"$ref": "#/$defs/tool_record"}, {"properties": {"name": {"const": "libreoffice"}, "version": {"pattern": "^sha256:[0-9A-F]{64}$"}, "scope": {"const": "repository_tools"}}}]}
  }
}
