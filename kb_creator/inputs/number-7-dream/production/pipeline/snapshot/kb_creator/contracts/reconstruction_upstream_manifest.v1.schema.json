{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.reconstruction_upstream_manifest.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "package_state", "scenario", "run", "reconstruction_contract", "source_identity", "review", "stages", "candidate", "content", "fidelity", "qa", "implementation", "package_files", "manifest_sha256"],
  "properties": {
    "schema": {"const": "kb_creator.reconstruction_upstream_manifest.v1"},
    "package_state": {"const": "candidate_awaiting_reconstruction_acceptance"},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "portable_identity_sha256"], "properties": {"run_id": {"type": "string", "minLength": 1}, "portable_identity_sha256": {"$ref": "#/$defs/sha256"}}},
    "reconstruction_contract": {"$ref": "#/$defs/contract"},
    "source_identity": {"$ref": "#/$defs/file"},
    "review": {"type": "object", "additionalProperties": false, "required": ["queue", "validated_submission", "decision_set", "decisions", "reviewed_allowlist"], "properties": {"queue": {"$ref": "#/$defs/file"}, "validated_submission": {"$ref": "#/$defs/file"}, "decision_set": {"$ref": "#/$defs/file"}, "decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "reviewed_allowlist": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}}},
    "stages": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/stage"}},
    "candidate": {"$ref": "#/$defs/inventory"},
    "content": {"$ref": "#/$defs/inventory"},
    "fidelity": {"$ref": "#/$defs/file"},
    "qa": {"$ref": "#/$defs/file"},
    "implementation": {"$ref": "#/$defs/inventory"},
    "package_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/relative_path"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["files", "inventory_sha256"], "properties": {"files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "inventory_sha256": {"$ref": "#/$defs/sha256"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["basename", "bytes", "sha256", "contract_revision"], "properties": {"basename": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "contract_revision": {"const": 1}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["stage_id", "stage_name", "manifest", "reproducible_sha256"], "properties": {"stage_id": {"type": "string", "pattern": "^0[1-6]-[a-z0-9-]+$"}, "stage_name": {"type": "string", "minLength": 1}, "manifest": {"$ref": "#/$defs/file"}, "reproducible_sha256": {"$ref": "#/$defs/sha256"}}},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[:\\\\\\u0000])(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|/|$))(?!.*[ .](?:/|$))[^/]+(?:/[^/]+)*$"
    }
  }
}
