          "start_text": "<!-- source-page-115 -->",
          "end_text": "![Complete front page of Enoch Jeremiah Eakins's pre-generated investigator sheet](../assets/ee6f908e8a15d1ee0f9f8a976427f1050ceef9810642f5ddfe1d172a0189bc3c.jpg)",
