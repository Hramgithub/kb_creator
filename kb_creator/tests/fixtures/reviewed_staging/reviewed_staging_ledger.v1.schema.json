{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb_creator.reviewed_staging_ledger.v1",
  "title": "Reviewed staging resolution ledger input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bindings", "pages"],
  "properties": {
    "schema": {"const": "kb_creator.reviewed_staging_ledger.v1"},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_manifest", "candidate_source_sha256", "target_queue", "target_source_sha256", "semantic_spec"],
      "properties": {
        "candidate_manifest": {"$ref": "#/$defs/identity"},
        "candidate_source_sha256": {"$ref": "#/$defs/sha"},
        "target_queue": {"$ref": "#/$defs/identity"},
        "target_source_sha256": {"$ref": "#/$defs/sha"},
        "semantic_spec": {"$ref": "#/$defs/identity"}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "source_key": {
      "type": "object", "additionalProperties": false,
      "required": ["view", "raw_index"],
      "properties": {
        "view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]},
        "raw_index": {"type": "integer", "minimum": 0}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["source_page", "candidate_page", "target_packet", "target_visual", "reading_order", "resolutions", "source_only", "page_review"],
      "properties": {
        "source_page": {"type": "integer", "minimum": 1},
        "candidate_page": {"$ref": "#/$defs/identity"},
        "target_packet": {"$ref": "#/$defs/identity"},
        "target_visual": {"$ref": "#/$defs/identity"},
        "reading_order": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "resolutions": {"type": "array", "items": {"$ref": "#/$defs/resolution"}},
        "source_only": {"type": "array", "items": {"$ref": "#/$defs/source_only"}},
        "key_map": {"type": "array", "items": {"$ref": "#/$defs/key_map"}},
        "page_review": {"$ref": "#/$defs/page_review"}
      }
    },
    "key_map": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "successor", "candidate_text_sha256", "successor_text_sha256"],
      "properties": {
        "candidate": {"$ref": "#/$defs/source_key"},
        "successor": {"$ref": "#/$defs/source_key"},
        "candidate_text_sha256": {"$ref": "#/$defs/sha"},
        "successor_text_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "source_keys", "action", "selected", "evidence", "reader_treatment"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "source_keys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_key"}},
        "action": {"enum": ["select_packet", "reviewed_correction", "visual_transcription", "exclude_furniture", "retain_unresolved"]},
        "selected": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["view", "raw_index", "purpose", "text_sha256"],
             "properties": {"view": {"enum": ["original_pipeline_txt", "original_pipeline_ocr", "raster_pipeline_ocr"]}, "raw_index": {"type": "integer", "minimum": 0}, "purpose": {"enum": ["text", "asset", "structure", "visual"]}, "text_sha256": {"$ref": "#/$defs/sha"}}}
          ]
        },
        "correction": {
          "type": "object", "additionalProperties": false,
          "required": ["before_sha256", "after", "after_sha256"],
          "properties": {"before_sha256": {"$ref": "#/$defs/sha"}, "after": {"type": "string", "minLength": 1}, "after_sha256": {"$ref": "#/$defs/sha"}}
        },
        "visual_assertion_id": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "region", "rationale"],
          "properties": {"source": {"$ref": "#/$defs/identity"}, "region": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "rationale": {"type": "string", "minLength": 1}}
        },
        "reader_treatment": {"enum": ["prose", "heading", "list", "quote", "table", "statblock", "asset", "visual", "furniture", "excluded", "unresolved"]}
      }
    },
    "source_only": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "reader_text", "visual_assertion_id", "evidence", "reader_treatment"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"const": "visual_transcription"},
        "reader_text": {"type": "string", "minLength": 1},
        "visual_assertion_id": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "region", "rationale"],
          "properties": {"source": {"$ref": "#/$defs/identity"}, "region": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "rationale": {"type": "string", "minLength": 1}}
        },
        "reader_treatment": {"enum": ["prose", "heading", "list", "quote", "table", "statblock", "visual"]}
      }
    },
    "page_review": {
      "type": "object", "additionalProperties": false,
      "required": ["source_visual", "final_markdown_sha256", "selected_blocks_sha256", "assets_sha256", "visual_reviewed", "receipt"],
      "properties": {
        "source_visual": {"$ref": "#/$defs/identity"},
        "final_markdown_sha256": {"$ref": "#/$defs/sha"},
        "selected_blocks_sha256": {"$ref": "#/$defs/sha"},
        "assets_sha256": {"$ref": "#/$defs/sha"},
        "visual_reviewed": {"type": "boolean"},
        "receipt": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
